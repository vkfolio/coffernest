# Copy to .env for local dev. In production set these as real environment variables.
ENV=dev
DATABASE_URL=postgresql+asyncpg://coffernest:coffernest@localhost:5433/coffernest
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=coffernest
JWT_SECRET=change-me-to-64-random-chars-change-me-to-64-random-chars
CORS_ORIGINS=["http://localhost:5173"]
ALLOW_REGISTRATION=true
# coffernest vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# AI: none | claude_agent | openai_compat
AI_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
