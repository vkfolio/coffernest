# Copy to .env next to docker-compose.yml. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
S3_ACCESS_KEY=coffernest
S3_SECRET_KEY=
# How phones and browsers reach MinIO (port 9000), e.g. https://files.example.com or http://192.168.1.20:9000
S3_PUBLIC_URL=http://localhost:9000
JWT_SECRET=
# Encrypts saved account numbers and PDF passwords. Keep it safe; losing it loses those values.
SECRET_ENC_KEY=
# The address the apps use, e.g. https://money.example.com
PUBLIC_URL=http://localhost:8080
# false: the first account becomes the admin, then only emails the admin adds can sign up.
ALLOW_REGISTRATION=false

# Optional demo account with a year of sample books, kept by the server itself. It never counts
# as the first account. Choose your own password (10+ characters).
SEED_DEMO=false
DEMO_EMAIL=
DEMO_PASSWORD=

# Optional assistant: none | claude_agent | openai_compat
AI_PROVIDER=none
# claude_agent: set one of these
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# openai_compat (OpenAI, OpenRouter, Ollama, LM Studio, ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Optional web push reminders: generate with `docker compose run --rm api coffernest vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
